# MarketSignalOS — environment variable reference
# Copy to .env and fill in values before running locally.
# All variables marked (required) must be set; others have working defaults.

# ─── Database ─────────────────────────────────────────────────────────────────
# When set, the API reads from Postgres and the ingestor writes to Postgres.
# When absent, both fall back to local JSONL files under services/ingestor/data/.
# Railway injects this automatically when a Postgres add-on is attached.
DATABASE_URL=postgresql://user:password@localhost:5432/marketsignalos

# ─── API server ───────────────────────────────────────────────────────────────
# Injected automatically by Railway. Defaults to 8080 locally.
PORT=8080

# ─── Ingestor ─────────────────────────────────────────────────────────────────
# (required) Comma-separated Kalshi market tickers to ingest.
# Example: KXBTC-24DEC31,KXETHUSD-24DEC31
INGEST_MARKET_TICKERS=

# Run the ingestor in a continuous loop (true for production, false for one-shot runs).
INGEST_CONTINUOUS=false

# Seconds between each ingestion loop iteration when INGEST_CONTINUOUS=true.
INGEST_INTERVAL_SECONDS=30

# Override the data directory used for JSONL files and checkpoints.
# Defaults to services/ingestor/data/ relative to the repo root.
# INGESTOR_DATA_DIR=

# Override individual JSONL store paths (used by both ingestor and API).
# Only needed when you want to point at a non-standard file location.
# INGESTOR_TRADE_STORE_PATH=
# INGESTOR_FILLS_STORE_PATH=
# INGESTOR_RESOLUTIONS_STORE_PATH=
# INGESTOR_ACCOUNT_ENRICHMENT_STORE_PATH=

# ─── Kalshi API credentials ───────────────────────────────────────────────────
# Choose ONE of the two auth methods below.

# Method 1 — simple Bearer token (read-only / limited endpoints)
# KALSHI_API_KEY=

# Method 2 — RSA keypair (full API access, required for fills)
# Both variables must be set together.
# KALSHI_API_KEY_ID=
# KALSHI_PRIVATE_KEY_PEM=   # PEM string with literal \n between lines

# Override the Kalshi base URL (defaults to the production API).
# KALSHI_BASE_URL=https://api.elections.kalshi.com/trade-api/v2

# ─── Frontend (Next.js) ───────────────────────────────────────────────────────
# URL of the FastAPI backend, used by Next.js server components.
# Must start with NEXT_PUBLIC_ to be available in the browser bundle.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
