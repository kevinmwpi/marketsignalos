# Paste these into the API service's Railway variables; no resources are
# provisioned by this file. Attach a persistent volume at /data first.
APP_ENV=production
RAILPACK_PYTHON_VERSION=3.12
POLYMARKET_DATA_DIR=/data
WEB_CONCURRENCY=1
# Generate a random token (32+ characters); do not reuse this placeholder.
ADMIN_API_TOKEN=
# Keep API-owned loops disabled while preparing the $15 worker deployment.
# Choose one ingestion owner; the lean pilot has separate cadence accounting.
INGEST_EVERY_MINUTES=0
INGEST_DEEP_EVERY_N_RUNS=0
FASTLANE_EVERY_SECONDS=0
INGEST_DEEP_WALLET_BATCH_SIZE=25
INGEST_DEEP_LEADERBOARD_DEPTH=100
INGEST_RECENT_TRADER_LIMIT=1000
INGEST_RECENT_TRADER_MAX_PAGES=20
POLYMARKET_WALLET_CONCURRENCY=2
POLYMARKET_API_RPS=3
DATA_STALE_AFTER_MINUTES=120
# Optional dashboard link; fill after the frontend receives its domain.
FRONTEND_URL=
# Optional Postgres mirror only. Migrate before enabling; not an API read store.
# DATABASE_URL=
