# MarketSignalOS — environment variable reference
# Copy to .env and fill in values before running locally.
# None of these are strictly required: the API and pipeline run end-to-end
# on public, unauthenticated endpoints. Set values only to override defaults
# or to enable optional features.

# ─── API server ───────────────────────────────────────────────────────────────
# Injected automatically by Railway. Defaults to 8080 locally.
# PORT=8080

# Public URL of the Next.js dashboard. When set, the API's landing page (/)
# shows an "Open dashboard" button pointing here. Optional.
# FRONTEND_URL=https://app.example.com

# ─── Database (optional) ──────────────────────────────────────────────────────
# When set, the Polymarket pipeline dual-writes JSONL + Postgres and the
# Postgres schema is available for read queries. When unset, everything
# stays on local JSONL files under the data dir.
# DATABASE_URL=postgresql://user:password@localhost:5432/marketsignalos

# ─── Polymarket pipeline ──────────────────────────────────────────────────────
# Override the data directory used for JSONL stores. Defaults to
# services/ingestor/data/ relative to the repo root (the path is kept for
# back-compat — the directory is gitignored).
# POLYMARKET_DATA_DIR=

# Override the wallet watchlist path. Auto-seeded each time the pipeline runs.
# POLYMARKET_WATCHLIST_PATH=

# Tuning for the Polymarket HTTP client.
# POLYMARKET_TIMEOUT_SECONDS=15
# POLYMARKET_MAX_RETRIES=3

# Kill switch for the legacy 'all' CLI subcommand. The web "Run ingest" button
# uses the in-process orchestrator and bypasses this flag. Only relevant if
# you run `marketsignalos-polymarket-ingestor all` from cron.
# INGEST_POLYMARKET=1

# ─── Frontend (Next.js) ───────────────────────────────────────────────────────
# URL of the FastAPI backend, used by Next.js server components.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
